{
  "name": "night-shift",
  "private": true,
  "version": "0.1.0",
  "description": "«Ночная смена» — психологический хоррор-симулятор ночного продавца для Яндекс Игр",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "preview:lan": "vite preview --host --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node scripts/e2e.mjs",
    "zip": "node scripts/zip.mjs"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@fontsource/caveat": "5.3.0",
    "@fontsource/pt-mono": "5.3.0",
    "@fontsource/pt-sans": "5.3.0",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ysdk": "1.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  }
}
